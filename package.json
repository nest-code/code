{
  "name": "software-engineer-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "sync": "svelte-kit sync",
    "dev": "wrangler types && svelte-kit sync && vite dev",
    "build": "wrangler types && svelte-kit sync && vite build",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "check": "wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.2",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/markdown-it": "^14.1.2",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "simple-icons": "^16.35.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.3.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.168.0"
  }
}
